{% comment %}
  Local CV layout (RenderCV data in _data/cv.yml): hero + sticky section nav + timeline sections.
  Sections render in cv.yml order. Entry shape decides the layout:
    position -> experience timeline, institution -> education timeline, ref/releaseDate -> publications,
    awarder -> awards, bullet -> plain list.
{% endcomment %}
{% assign cv = site.data.cv.cv %}
<div class="cv-page">
  <header class="cv-hero">
    <div>
      <h1 class="cv-name">{{ cv.name }}</h1>
      <p class="cv-label">{{ cv.label }}{% if cv.location %} · {{ cv.location }}{% endif %}</p>
      {% if cv.sections['Research Interests'] %}
        <p class="cv-summary">{{ cv.sections['Research Interests'].first.bullet | markdownify | remove: '<p>' | remove: '</p>' }}</p>
      {% endif %}
    </div>
    <div class="cv-actions">
      {% if page.cv_pdf %}
        <a class="cv-btn cv-btn-primary" href="{{ page.cv_pdf | relative_url }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-file-pdf"></i> Download PDF</a>
      {% endif %}
      {% if site.data.socials.github_username %}<a class="cv-btn" href="https://github.com/{{ site.data.socials.github_username }}"><i class="fa-brands fa-github"></i> GitHub</a>{% endif %}
      {% if site.data.socials.linkedin_username %}<a class="cv-btn" href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}"><i class="fa-brands fa-linkedin"></i> LinkedIn</a>{% endif %}
      {% if site.data.socials.scholar_userid %}<a class="cv-btn" href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"><i class="ai ai-google-scholar"></i> Scholar</a>{% endif %}
    </div>
  </header>

  <div class="cv-layout">
    <nav class="cv-nav" aria-label="CV sections">
      {% for s in cv.sections %}{% if s[0] != 'Research Interests' %}
        <a href="#{{ s[0] | slugify }}">{{ s[0] }}</a>
      {% endif %}{% endfor %}
    </nav>

    <div class="cv-main">
      {% for section_pair in cv.sections %}
        {% assign title = section_pair[0] %}
        {% assign entries = section_pair[1] %}
        {% if title == 'Research Interests' %}{% continue %}{% endif %}
        <section class="cv-section" id="{{ title | slugify }}">
          <h2>{{ title }}</h2>
          {% assign first = entries.first %}

          {% if first.position or first.institution %}
            <div class="cv-timeline">
              {% for e in entries %}
                <article class="cv-item">
                  <div class="cv-when">
                    {% if e.start_date %}
                      {% include cv/fmt_date.liquid d=e.start_date %} – {% if e.end_date %}{% include cv/fmt_date.liquid d=e.end_date %}{% else %}Present{% endif %}
                    {% elsif e.date %}{% include cv/fmt_date.liquid d=e.date %}{% elsif e.end_date %}{% include cv/fmt_date.liquid d=e.end_date %}{% endif %}
                  </div>
                  <div class="cv-what">
                    {% if e.position %}
                      <h3>{{ e.position }}</h3>
                      <div class="cv-org">{{ e.company }}{% if e.location %} · {{ e.location }}{% endif %}</div>
                    {% else %}
                      <h3>{{ e.studyType }} in {{ e.area }}</h3>
                      <div class="cv-org">{% if e.url %}<a href="{{ e.url }}">{{ e.institution }}</a>{% else %}{{ e.institution }}{% endif %}{% if e.location %} · {{ e.location }}{% endif %}</div>
                    {% endif %}
                    {% if e.summary %}<p class="cv-note">{{ e.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>{% endif %}
                    {% if e.highlights %}
                      <ul>{% for h in e.highlights %}<li>{{ h | markdownify | remove: '<p>' | remove: '</p>' }}</li>{% endfor %}</ul>
                    {% endif %}
                  </div>
                </article>
              {% endfor %}
            </div>

          {% elsif first.ref %}
            <p class="cv-mentee-note"><span class="cv-dagger">†</span> Student mentee</p>
            <div class="cv-pubs">
              {% assign last_group = '' %}
              {% for e in entries %}
                {% if e.group and e.group != last_group %}
                  <h3 class="cv-subhead">{{ e.group }}</h3>
                  {% assign last_group = e.group %}
                {% endif %}
                <article class="cv-pub">
                  <div class="cv-ref"><span>{{ e.ref }}</span><small>{{ e.releaseDate }}</small></div>
                  <div>
                    <h3>{% if e.url %}<a href="{{ e.url }}">{{ e.title }}</a>{% else %}{{ e.title }}{% endif %}</h3>
                    <div class="cv-authors">{{ e.summary | markdownify | remove: '<p>' | remove: '</p>' }}</div>
                    <div class="cv-venue">{{ e.publisher }}</div>
                  </div>
                </article>
              {% endfor %}
            </div>

          {% elsif first.awarder %}
            <div class="cv-awards">
              {% for e in entries %}
                <article class="cv-award">
                  <span class="cv-year">{{ e.date }}</span>
                  <h3>{{ e.title }}</h3>
                  <div class="cv-org">{{ e.awarder }}</div>
                  {% if e.summary %}<p>{{ e.summary }}</p>{% endif %}
                </article>
              {% endfor %}
            </div>

          {% else %}
            <ul class="cv-bullets">
              {% for e in entries %}<li>{{ e.bullet | markdownify | remove: '<p>' | remove: '</p>' }}</li>{% endfor %}
            </ul>
          {% endif %}
        </section>
      {% endfor %}
    </div>
  </div>
</div>
